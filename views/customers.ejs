<%- include('partials/header', { title: 'Customers | Hardware Hub', activePage: 'customers' }) %>
    <main class="page-shell">
    <div class="page-heading"><span class="eyebrow">Relationships</span><h1>Customers Directory</h1><p>Keep customer details close to every sale.</p></div>

  <div class="panel">
    <h2>Add New Customer</h2>
    <form action="/add-customer" method="POST">
      <input type="number" name="customers_id" placeholder="Customer ID" required>
      <input type="text" name="customer_name" placeholder="Customer Name" required>
      <input type="text" name="contact" placeholder="Contact (Phone)" required>
      <input type="text" name="address" placeholder="Address" required>
      <button class="button" type="submit">Add Customer</button>
    </form>
  </div>

  <div class="table-wrap"><table>
    <thead>
      <tr>
        <th>Customer ID</th>
        <th>Customer Name</th>
        <th>Contact</th>
        <th>Address</th>
      </tr>
    </thead>
    <tbody>
      <% if (customers && customers.length > 0) { %>
        <% customers.forEach(function(cust) { %>
          <tr>
            <td><%= cust.customers_id %></td>
            <td><%= cust.customer_name %></td>
            <td><%= cust.contact %></td>
            <td><%= cust.address %></td>
          </tr>
        <% }); %>
      <% } else { %>
        <tr>
          <td class="empty-state" colspan="4">No customers found.</td>
        </tr>
      <% } %>
    </tbody>
  </table></div>
  </main>

<%- include('partials/footer') %>
