<%- include('partials/header', { title: 'Employees | Hardware Hub', activePage: 'employees' }) %>
    <main class="page-shell">
    <div class="page-heading"><span class="eyebrow">Your team</span><h1>Employees Directory</h1><p>Keep your people and roles organized.</p></div>


  <div class="panel">
    <h2>Add New Employee</h2>
    <form action="/add-employee" method="POST">
      <input type="number" name="EmployeeID" placeholder="Employee ID" required>
      <input type="text" name="FirstName" placeholder="First Name" required>
      <input type="text" name="PhoneNumber" placeholder="Phone Number" required>
      <input type="text" name="Position" placeholder="Position" required>
      <button class="button" type="submit">Add Employee</button>
    </form>
  </div>


  <div class="table-wrap"><table>
    <thead>
      <tr>
        <th>Employee ID</th>
        <th>First Name</th>
        <th>Phone Number</th>
        <th>Position</th>
      </tr>
    </thead>
    <tbody>
      <% if (employees && employees.length > 0) { %>
        <% employees.forEach(function(emp) { %>
          <tr>
            <td><%= emp.EmployeeID %></td>
            <td><%= emp.FirstName %></td>
            <td><%= emp.PhoneNumber %></td>
            <td><%= emp.Position %></td>
          </tr>
        <% }); %>
      <% } else { %>
        <tr>
          <td class="empty-state" colspan="4">No employees found.</td>
        </tr>
      <% } %>
    </tbody>
  </table></div>
  </main>

<%- include('partials/footer') %>
    