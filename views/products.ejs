<%- include('partials/header', {
    title: 'Products | Hardware Hub',
    description: 'Manage your hardware products and inventory.',
    activePage: 'products'
}) %>
<main class="page-shell">
      <div class="page-heading"><span class="eyebrow">Inventory</span><h1>Product Inventory</h1><p>Keep your catalogue and stock levels up to date.</p></div>

  <div class="panel">
    <h2>Add New Product</h2>
    <form action="/add-product" method="POST">
      <input type="number" name="product_id" placeholder="Product ID" required>
      <input type="text" name="productname" placeholder="Product Name" required>
      <input type="number" name="unitprice" placeholder="Unit Price" step="1" required>
      <input type="number" name="stockquantity" placeholder="Stock Quantity" required>
      <button class="button" type="submit">Add Product</button>
    </form>
  </div>

  <div class="table-wrap"><table>
    <thead>
      <tr>
        <th>Product ID</th>
        <th>Product Name</th>
        <th>Unit Price</th>
        <th>Stock Quantity</th>
      </tr>
    </thead>
    <tbody>
      <% if (products && products.length > 0) { %>
        <% products.forEach(function(p) { %>
          <tr>
            <td><%= p.product_id %></td>
            <td><%= p.productname %></td>
            <td><%= p.unitprice %></td>
            <td><%= p.stockquantity %></td>
          </tr>
        <% }); %>
      <% } else { %>
        <tr>
          <td class="empty-state" colspan="4">No products found.</td>
        </tr>
      <% } %>
    </tbody>
  </table></div>
  </main>

<%- include('partials/footer') %>
    