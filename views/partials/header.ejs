<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="<%= typeof description !== 'undefined' ? description : 'Hardware Hub helps hardware businesses manage stocks, sales, suppliers, employees, and products.' %>">
    <title><%= title || 'Hardware Hub' %></title>
    <link rel="stylesheet" href="/main.css">
</head>
<body>
    <header class="site-header">
        <nav class="site-nav" aria-label="Main navigation">
            <a class="brand" href="/">
                <span class="brand-mark">HH</span>
                <span class="brand-name">Hardware Hub</span>
            </a>

            <ul class="nav-links">
                <% if (isLoggedIn) { %>
                    <!-- Protected Owner / Admin Links (Only visible when logged in) -->
                    <li><a href="/dashboard" aria-current="<%= activePage === 'dashboard' ? 'page' : '' %>">Dashboard</a></li>
                    <li><a href="/products" aria-current="<%= activePage === 'products' ? 'page' : '' %>">Products</a></li>
                    <li><a href="/sales" aria-current="<%= activePage === 'sales' ? 'page' : '' %>">Sales</a></li>
                    <li><a href="/suppliers" aria-current="<%= activePage === 'suppliers' ? 'page' : '' %>">Suppliers</a></li>
                    <li><a href="/employees" aria-current="<%= activePage === 'employees' ? 'page' : '' %>">Employees</a></li>
                    <li><a href="/customers" aria-current="<%= activePage === 'customers' ? 'page' : '' %>">Customers</a></li>
                <% } else { %>
                    <!-- Public Customer Links (Only visible when logged out) -->
                    <li><a href="/shop" aria-current="<%= activePage === 'shop' ? 'page' : '' %>">Shop</a></li>
                    <li>
                        <a href="/cart" aria-current="<%= activePage === 'cart' ? 'page' : '' %>">
                            Cart (<%= cart ? cart.reduce((acc, item) => acc + item.quantity, 0) : 0 %>)
                        </a>
                    </li>
                <% } %>
            </ul>

            <div class="nav-actions">
                <% if (isLoggedIn) { %>
                    <a class="nav-login" href="/logout" style="color: #d9534f;">Log out</a>
                <% } else { %>
                    <a class="nav-login" href="/login">Log in</a>
                <% } %>
                <a class="button button-small" href="/contact">Contact us</a>
            </div>
        </nav>
    </header>