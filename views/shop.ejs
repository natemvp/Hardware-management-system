<%- include('partials/header', {
    title: 'Shop | Hardware Hub',
    description: 'Browse hardware products.',
    activePage: 'shop'
}) %>

<main class="page-shell">
  <div class="page-heading" style="display: flex; justify-content: space-between; align-items: center;">
    <div>
      <span class="eyebrow">Customer Store</span>
      <h1>Hardware Store</h1>
      <p>Select items and quantities to add them to your cart.</p>
    </div>
    <div>
      <a href="/cart" class="button button-secondary">
        🛒 View Cart (<%= cart.reduce((total, item) => total + item.quantity, 0) %>)
      </a>
    </div>
  </div>

  <div class="product-grid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 20px; margin-top: 24px;">
    <% if (products && products.length > 0) { %>
      <% products.forEach(function(p) { %>
        <div class="panel" style="display: flex; flex-direction: column; justify-content: space-between;">
          <div>
            <h3 style="margin-top: 0;"><%= p.productname %></h3>
            <p style="font-size: 1.25rem; font-weight: bold; margin: 8px 0;">KSh <%= p.unitprice %></p>
            <p style="color: #666; font-size: 0.9rem;">Available Stock: <%= p.stockquantity %></p>
          </div>

          <form action="/add-to-cart" method="POST" style="margin-top: 16px; display: flex; gap: 8px; align-items: center;">
            <input type="hidden" name="product_id" value="<%= p.product_id %>">
            <input 
              type="number" 
              name="quantity" 
              value="1" 
              min="1" 
              max="<%= p.stockquantity %>" 
              style="width: 70px; padding: 6px;" 
              required
            >
            <button class="button" type="submit" style="flex-grow: 1;">Add to Cart</button>
          </form>
        </div>
      <% }); %>
    <% } else { %>
      <p>No products currently available.</p>
    <% } %>
  </div>
</main>

<%- include('partials/footer') %>