<%- include('partials/header', { title: 'Suppliers | Hardware Hub', activePage: 'suppliers' }) %>
    <main class="page-shell">
    <div class="page-heading"><span class="eyebrow">Supply chain</span><h1>Suppliers Directory</h1><p>Make supplier details easy to find when you need them.</p></div>

  <div class="panel">
    <h2>Add New Supplier</h2>
    <form action="/add-supplier" method="POST">
      <input type="number" name="SupplierID" placeholder="Supplier ID" required>
      <input type="text" name="SupplierName" placeholder="Supplier Name" required>
      <input type="text" name="PhoneNumber" placeholder="Phone Number" required>
      <input type="text" name="Address" placeholder="Address" required>
      <button class="button" type="submit">Add Supplier</button>
    </form>
  </div>

  <div class="table-wrap"><table>
    <thead>
      <tr>
        <th>Supplier ID</th>
        <th>Supplier Name</th>
        <th>Phone Number</th>
        <th>Address</th>
      </tr>
    </thead>
    <tbody>
      <% if (suppliers && suppliers.length > 0) { %>
        <% suppliers.forEach(function(sup) { %>
          <tr>
            <td><%= sup.SupplierID %></td>
            <td><%= sup.SupplierName %></td>
            <td><%= sup.PhoneNumber %></td>
            <td><%= sup.Address %></td>
          </tr>
        <% }); %>
      <% } else { %>
        <tr>
          <td class="empty-state" colspan="4">No suppliers found.</td>
        </tr>
      <% } %>
    </tbody>
  </table></div>
  </main>

<%- include('partials/footer') %>
    